<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog id="createProductDialog" title="Create New Product">
        <content>
            <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <form:content>
                    <Label text="Name" required="true"/>
                    <Input id="nameInput" value=""/>
                    <Label text="Description" required="true"/>
                    <Input id="descrInput" value=""/>
                    <Label text="Price" required="true"/>
                    <Input id="priceInput" value="" type="Number"/>
                    <Label text="Quantity"/>
                    <Input id="quantityInput" value="" type="Number"/>
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button text="Save" type="Emphasized" press="onSaveProduct"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
